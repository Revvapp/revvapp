# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
firebase-debug.log
*.log

# macOS
.DS_Store
*.pem

# local env files
.env
functions/.env*

# GoogleService-Info.plist and google-services.json are intentionally NOT
# ignored: app.json's googleServicesFile fields point at them, ios/+android/
# are gitignored below and regenerated by EAS from app.json on every build, so
# an ignored config file would be invisible to EAS and prebuild would fail.
# These are client config (an app-embedded API key + bundle/package id), not
# secrets — Firebase's own docs say committing them is normal.

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# claude tool artifacts
.claude/

# Local editor/tooling state, not project source.
skills-lock.json
