// Revv — Cloud Storage security rules.
// Deployed via the CLI: firebase deploy --only storage
// (wired through firebase.json). Firestore rules live in ../firestore.rules.

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // True only for the client or detailer on the underlying booking. Reads the
    // booking doc from Firestore so a stranger who happens to know a bookingId
    // can neither view nor tamper with that job's photos. The VIR is the
    // damage-liability record, so write access in particular must be locked to
    // the two parties.
    function isBookingParty(bookingId) {
      return request.auth != null
        && (
          firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data.clientId == request.auth.uid
          || firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data.detailerId == request.auth.uid
        );
    }

    function booking(bookingId) {
      return firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data;
    }

    function validImage(maxBytes) {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= maxBytes
        && request.resource.contentType.matches('image/(jpeg|png|heic|heif|webp)');
    }

    match /detailers/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && validImage(10 * 1024 * 1024);
    }

    match /vir-photos/{bookingId}/{allPaths=**} {
      allow read: if isBookingParty(bookingId);
      allow write: if request.auth != null
        && booking(bookingId).detailerId == request.auth.uid
        && booking(bookingId).status == 'active'
        && validImage(12 * 1024 * 1024);
    }

    match /after-photos/{bookingId}/{allPaths=**} {
      allow read: if isBookingParty(bookingId);
      allow write: if request.auth != null
        && booking(bookingId).detailerId == request.auth.uid
        && booking(bookingId).status == 'completed'
        && booking(bookingId).get('afterPhotosFinalizedAt', null) == null
        && validImage(12 * 1024 * 1024);
    }

    match /disputes/{bookingId}/{uid}/{allPaths=**} {
      allow read: if isBookingParty(bookingId);
      allow write: if request.auth != null
        && request.auth.uid == uid
        && booking(bookingId).clientId == request.auth.uid
        && booking(bookingId).status == 'completed'
        && validImage(12 * 1024 * 1024);
    }

  }
}
