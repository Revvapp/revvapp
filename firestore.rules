// Revv — Firestore security rules.
// Deployed via the CLI: firebase deploy --only firestore:rules
// (wired through firebase.json). Storage rules live in ../storage.rules.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.get('isFoundingPro', false) == false
        && request.resource.data.get('subscriptionStatus', 'pending') == 'pending'
        && request.resource.data.get('trialDays', 0) == 0
        && request.resource.data.get('trialStartDate', null) == null;
      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.userType == resource.data.userType
        && request.resource.data.get('isFoundingPro', false) == resource.data.get('isFoundingPro', false)
        && request.resource.data.get('subscriptionStatus', '') == resource.data.get('subscriptionStatus', '')
        && request.resource.data.get('trialDays', 0) == resource.data.get('trialDays', 0)
        && request.resource.data.get('trialStartDate', null) == resource.data.get('trialStartDate', null);
      // Owner may delete their own account (App Store account-deletion requirement).
      // Account deletion is an Admin SDK workflow so related data can be
      // cleaned/anonymized consistently before the Auth identity disappears.
      allow delete: if false;
    }

    match /detailers/{uid} {
      // Marketplace profiles are readable by any signed-in user (clients browse
      // and book detailers), but NOT by anonymous callers. A detailer doc carries
      // phone number and precise lat/lng; `if true` exposed that to unauthenticated
      // scraping. Every legitimate reader (find screen, profile screen) is already
      // signed in, so this is transparent to the app.
      allow read: if signedIn();

      // A detailer manages their own public profile, but must never forge trust
      // signals. rating/reviewCount/ratingSum are owned by the
      // aggregateDetailerRating Cloud Function (Admin SDK — bypasses these
      // rules); idVerified is earned via background check, never self-granted.
      // So a freshly created profile starts unverified with a zeroed rating.
      allow create: if isOwner(uid)
        && get(/databases/$(database)/documents/users/$(uid)).data.userType == 'detailer'
        && request.resource.data.uid == uid
        && request.resource.data.get('idVerified', false) == false
        && request.resource.data.get('rating', 0) == 0
        && request.resource.data.get('reviewCount', 0) == 0
        && request.resource.data.get('ratingSum', 0) == 0
        // Payout eligibility and the Stripe account are set only by the Connect
        // Cloud Functions (Admin SDK). A detailer must not self-grant either —
        // payoutsEnabled gates marketplace visibility and booking eligibility.
        && request.resource.data.get('payoutsEnabled', false) == false
        && request.resource.data.get('stripeAccountId', '') == ''
        && request.resource.data.get('stripeAccountVersion', '') == ''
        // The Stripe *customer* id (subscription billing) is server-owned too: a
        // detailer who could set it to a known active customer's id would have the
        // subscription webhook flip their isActive on for free.
        && request.resource.data.get('stripeCustomerId', '') == ''
        && request.resource.data.get('isActive', false) == false;

      // Updates may not change any protected trust field — each must carry
      // through unchanged from the stored doc (which only the Admin SDK sets).
      // Profile edits (name, bio, rates, availability) leave these untouched, so
      // this is transparent to every legitimate write.
      allow update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.get('idVerified', false) == resource.data.get('idVerified', false)
        && request.resource.data.get('isFoundingPro', false) == resource.data.get('isFoundingPro', false)
        && request.resource.data.get('rating', 0) == resource.data.get('rating', 0)
        && request.resource.data.get('reviewCount', 0) == resource.data.get('reviewCount', 0)
        && request.resource.data.get('ratingSum', 0) == resource.data.get('ratingSum', 0)
        && request.resource.data.get('stripeAccountId', '') == resource.data.get('stripeAccountId', '')
        && request.resource.data.get('stripeAccountVersion', '') == resource.data.get('stripeAccountVersion', '')
        && request.resource.data.get('stripeCustomerId', '') == resource.data.get('stripeCustomerId', '')
        && request.resource.data.get('payoutsEnabled', false) == resource.data.get('payoutsEnabled', false)
        && request.resource.data.get('isActive', false) == resource.data.get('isActive', false);

      allow delete: if false;
    }

    match /clients/{uid} {
      allow read: if isOwner(uid);
      // stripeCustomerId is server-owned (set by the Stripe Cloud Functions via
      // the Admin SDK). A client must never write it: a forged customer id would
      // make the server mint a Stripe ephemeral key for someone else's customer.
      allow create: if isOwner(uid)
        && get(/databases/$(database)/documents/users/$(uid)).data.userType == 'client'
        && request.resource.data.uid == uid
        && request.resource.data.get('stripeCustomerId', '') == '';
      allow update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.get('stripeCustomerId', '') == resource.data.get('stripeCustomerId', '');
      allow delete: if false;

      match /vehicles/{vehicleId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.ownerId == uid;
        allow delete: if isOwner(uid);
      }
    }

    match /bookings/{bookingId} {
      allow read: if signedIn()
        && (resource.data.clientId == request.auth.uid
            || resource.data.detailerId == request.auth.uid);

      // All writes go through server workflows. This makes prices, parties,
      // liability evidence, lifecycle timestamps and Stripe state authoritative.
      allow create, update, delete: if false;
    }

    match /invoices/{invoiceId} {
      allow read: if signedIn() && (
        resource == null ||
        resource.data.detailerId == request.auth.uid ||
        resource.data.clientId == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    match /reviews/{reviewId} {
      // Reviews are public so detailer profiles can display them.
      allow read: if signedIn();
      // Only the booking's own client may post, and only for a completed booking.
      // The review's doc id MUST equal its bookingId — combined with the
      // update/delete denial below, that caps it at exactly one review per
      // booking. Without this, a client could addDoc() many random-id reviews
      // for the same booking and inflate or tank a detailer's aggregate rating.
      allow create: if signedIn()
        && reviewId == request.resource.data.bookingId
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.bookingId is string
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.clientId == request.auth.uid
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == 'completed'
        // A "verified" review must be backed by a real, released transaction —
        // not merely a job the detailer marked complete. Payment releases (hold
        // captured + transfer) flip the booking's paymentStatus to 'captured'
        // after the 24h dispute window, so gating on it enforces the documented
        // rule "reviews only unlock after payment releases" at the database level.
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.get('paymentStatus', '') == 'captured'
        // The review must target the SAME detailer as the booking, and the score
        // must be a real 1–5. Without this a client could set detailerId to any
        // (publicly listed) detailer and rating to any magnitude, poisoning that
        // victim's aggregate via the aggregateDetailerRating function.
        && request.resource.data.detailerId == get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.detailerId
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      // Reviews are permanent.
      allow update, delete: if false;
    }

    match /disputes/{disputeId} {
      allow read: if signedIn()
        && (resource.data.clientId == request.auth.uid
            || resource.data.detailerId == request.auth.uid);
      // Created and responded to through transactional server workflows.
      allow create, update, delete: if false;
    }

    match /reports/{reportId} {
      // A report is a confidential flag to the REVV trust & safety team, NOT a
      // message to the other party — so the reported user must never be able to
      // read it. Only the author can read their own reports; the team uses the
      // Admin SDK (which bypasses these rules).
      allow read: if signedIn() && resource.data.reporterId == request.auth.uid;
      // Only a party on the underlying booking may file one, stamped as
      // themselves. clientId/detailerId carry the booking parties so the team
      // knows who was reported; one of them must be the reporter.
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.bookingId is string
        && exists(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId))
        && (request.resource.data.reporterRole == 'client'
            || request.resource.data.reporterRole == 'detailer')
        && request.resource.data.clientId == get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.clientId
        && request.resource.data.detailerId == get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.detailerId
        && (get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.clientId == request.auth.uid
            || get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.detailerId == request.auth.uid);
      // Immutable — reports are handled by the team off-platform.
      allow update, delete: if false;
    }

    match /careClaims/{claimId} {
      // A Revv Care damage claim is confidential to the filing client and the
      // REVV team — the reported detailer must never see it. Claims are created
      // and decided only through server workflows (createCareClaim /
      // resolveCareClaim), which enforce the 72-hour window, party, and cap; the
      // Revv Care reserve ledger (revvCareLedger / revvCareFund) is server-only
      // and unlisted here, so it is default-denied to every client.
      allow read: if signedIn() && resource.data.clientId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /emailLookup/{emailId} {
      // Never expose account existence, role or uid to unauthenticated callers.
      allow read: if signedIn()
        && request.auth.token.email != null
        && emailId == request.auth.token.email.lower();
      // A user may only write the lookup for their OWN email (the doc id is the
      // lowercased email), and only point it at their own uid. Stops a signed-in
      // user from overwriting someone else's email→userType/uid mapping and
      // hijacking how that account is resolved at sign-in.
      allow write: if signedIn()
        && request.auth.token.email != null
        && emailId == request.auth.token.email.lower()
        && request.resource.data.uid == request.auth.uid;
    }

    match /pushTokens/{uid} {
      // Notifications are sent server-side (Cloud Functions, Admin SDK), so the
      // client never needs to read another user's token. Lock read+write to the
      // owner — a client can manage its own token and nothing more. The Admin
      // SDK bypasses these rules, so the notification functions still read freely.
      allow read, write: if isOwner(uid);
    }

    match /stripeEvents/{eventId} {
      // Written only by the Stripe webhook (Admin SDK) as an idempotency ledger.
      // Never client-accessible.
      allow read, write: if false;
    }

    // A conversation lives at conversations/{bookingId} — its doc id is the
    // booking id, so the booking is the source of truth for who may take part.
    match /conversations/{bookingId} {
      function booking() {
        return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
      }
      // True only for the actual client/detailer on the underlying booking.
      // Reads the booking (not the conversation's own fields) so participation
      // can't be forged by writing the conversation doc.
      function isBookingParty() {
        return signedIn()
          && exists(/databases/$(database)/documents/bookings/$(bookingId))
          && (booking().clientId == request.auth.uid
              || booking().detailerId == request.auth.uid);
      }

      // Read/list off the conversation's own participant fields — no cross-doc
      // get(), so listing a user's threads (where clientId/detailerId == uid)
      // stays a single cheap query. Those fields are trustworthy because the
      // write rule below forces them to match the booking.
      allow read: if signedIn()
        && (resource.data.clientId == request.auth.uid
            || resource.data.detailerId == request.auth.uid);

      // Only a real booking party may write the thread doc, and they can only
      // stamp the true participant ids from the booking. Stops a stranger who
      // knows a booking id from hijacking the thread or reading its messages.
      allow create, update: if isBookingParty()
        && request.resource.data.clientId == booking().clientId
        && request.resource.data.detailerId == booking().detailerId;

      allow delete: if false;

      match /messages/{messageId} {
        // Only the two booking parties can read the thread's messages.
        allow read: if isBookingParty();
        // A party may post, but only as themselves — no spoofing senderId.
        allow create: if isBookingParty()
          && request.resource.data.senderId == request.auth.uid;
        // Messages are an immutable record.
        allow update, delete: if false;
      }
    }

  }
}
